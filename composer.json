{
    "name": "neuron-core/iq-php-sdk",
    "description": "PHP SDK connecting Neuron AI workflows to the IQ platform for durable orchestration.",
    "type": "library",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Valerio Barbera",
            "email": "valerio@inspector.dev"
        }
    ],
    "license": "MIT",
    "bin": [
        "bin/iq-gate",
        "bin/iq-dataset"
    ],
    "require": {
        "php": "^8.1",
        "neuron-core/neuron-ai": "^4.1.19"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "opis/json-schema": "^2.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.0",
        "tomasvotruba/type-coverage": "^2.0"
    },
    "scripts": {
        "style": [
            "php-cs-fixer fix --allow-risky=yes"
        ],
        "refactor": [
            "vendor/bin/rector"
        ],
        "format": [
            "@refactor",
            "@style"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G -v"
        ],
        "test": [
            "vendor/bin/phpunit --colors=always"
        ],
        "pre-release": [
            "@format",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan static analysis.",
        "format": "Run PHP CS Fixer and Rector in a pipeline.",
        "style": "Run PHP CS Fixer to fix coding style issues.",
        "refactor": "Run rector for code refactoring.",
        "test": "Run PHPUnit to test"
    },
    "autoload": {
        "psr-4": {
            "NeuronCore\\IQ\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NeuronCore\\IQ\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "process-timeout": 600
    }
}
