{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Sync answer",
    "description": "The 200 answer to a sync. An older version with no open run is retirable; the highest registered one never is. A stranded version left the code while runs remain.",
    "type": "object",
    "required": ["protocol", "modified", "versions", "stranded"],
    "properties": {
        "protocol": {
            "$ref": "definitions.json#/$defs/protocol"
        },
        "modified": {
            "description": "False when the sync changed nothing.",
            "type": "boolean"
        },
        "versions": {
            "type": "array",
            "items": {
                "$ref": "definitions.json#/$defs/openRuns"
            }
        },
        "stranded": {
            "type": "array",
            "items": {
                "$ref": "definitions.json#/$defs/openRuns"
            }
        }
    }
}
