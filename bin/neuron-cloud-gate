#!/usr/bin/env php
<?php

declare(strict_types=1);

use NeuronCore\Cloud\Evaluation\EvaluationGate;
use NeuronCore\Cloud\Evaluation\RunContext;
use NeuronCore\Cloud\NeuronCloud;

$autoload = $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Run composer install first.\n");
    exit(2);
}

require $autoload;

$apiKey = getenv('NEURON_CLOUD_API_KEY');

if ($apiKey === false || $apiKey === '') {
    fwrite(STDERR, "Set NEURON_CLOUD_API_KEY: the API key of the Neuron Cloud project.\n");
    exit(EvaluationGate::UNKNOWN);
}

$platformUrl = getenv('NEURON_CLOUD_PLATFORM_URL');
$cloud = is_string($platformUrl) && $platformUrl !== ''
    ? new NeuronCloud($apiKey, platformUrl: $platformUrl)
    : new NeuronCloud($apiKey);

try {
    exit((new EvaluationGate($cloud, RunContext::detect(), static function (string $line): void {
        echo $line, PHP_EOL;
    }))->run());
} catch (Throwable $e) {
    fwrite(STDERR, $e->getMessage() . PHP_EOL);
    exit(EvaluationGate::UNKNOWN);
}
